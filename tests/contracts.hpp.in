#pragma once
#include <eosio/testing/tester.hpp>

namespace eosio::testing {

struct contracts {
   static std::vector<uint8_t> grab_cisum_wasm() { return read_wasm("${CMAKE_BINARY_DIR}/contracts/grab.cisum/grab.cisum.wasm"); }
   static std::vector<char>    grab_cisum_abi()  { return read_abi("${CMAKE_BINARY_DIR}/contracts/grab.cisum/grab.cisum.abi"); }
   static std::vector<uint8_t> nestar_token_wasm() { return read_wasm("${CMAKE_BINARY_DIR}/contracts/nestar.token/nestar.token.wasm"); }
   static std::vector<char>    nestar_token_abi()  { return read_abi("${CMAKE_BINARY_DIR}/contracts/nestar.token/nestar.token.abi"); }
   static std::vector<uint8_t> cvticket_nft_wasm() { return read_wasm("${CMAKE_BINARY_DIR}/contracts/ticket.cvnft/ticket.cvnft.wasm"); }
   static std::vector<char>    cvticket_nft_abi()  { return read_abi("${CMAKE_BINARY_DIR}/contracts/ticket.cvnft/ticket.cvnft.abi"); }
   static std::vector<uint8_t> cisum_token_wasm() { return read_wasm("${CMAKE_BINARY_DIR}/contracts/cisum.token/cisum.token.wasm"); }
   static std::vector<char>    cisum_token_abi()  { return read_abi("${CMAKE_BINARY_DIR}/contracts/cisum.token/cisum.token.abi"); }
   static std::vector<uint8_t> cisum_vault_wasm() { return read_wasm("${CMAKE_BINARY_DIR}/contracts/cisum.vault/cisum.vault.wasm"); }
   static std::vector<char>    cisum_vault_abi()  { return read_abi("${CMAKE_BINARY_DIR}/contracts/cisum.vault/cisum.vault.abi"); }
};

} // namespace eosio::testing
